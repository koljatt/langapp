{
  "name": "langapp",
  "main": "worker/index.js",
  // Cloudflaren deploy ajaa pelkän `wrangler versions upload` ilman erillistä
  // build-vaihetta, joten wrangler ajaa buildin itse ennen latausta.
  "build": {
    "command": "npm run build"
  },
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Gemini-mallin tunnus (ai.google.dev/gemini-api/docs/models).
    "GEMINI_MODEL": "gemini-3.8-flash"
  },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
